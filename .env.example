# CanibookStud environment variables
# Set project-specific values in .env.local.

# Required for actual sessions and production. For an anonymous local demo,
# leave both Supabase settings empty and use NEXT_PUBLIC_DATA_MODE=demo.
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo catalog and preview settings
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_DEMO_DELAY_MS=0
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SITE_URL=https://example.com

# Server only. Leave empty until Stripe operations are enabled.
STRIPE_SECRET_KEY=

# Stripe sandbox. Set NEXT_PUBLIC_SITE_URL to the actual app origin.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional for a separate Connect webhook destination.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Server-only Supabase secret/service_role key for trusted payment writes.
SUPABASE_SERVICE_ROLE_KEY=

# USD cents; snapshot these amounts when a reservation is opened.
STUD_DEPOSIT_CENTS=40000
STUD_PLATFORM_FEE_CENTS=8000

PUPPY_SERVICE_FEE_CENTS=60000
