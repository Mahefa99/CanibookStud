# Use a flat node_modules layout.
#
# Next.js 15's CommonJS require hook resolves internal dependencies such as
# styled-jsx and @swc/helpers through `next/node_modules`. Under the local
# Node 24 runtime, pnpm's isolated symlink layout is not followed from that
# hook, so the build fails with MODULE_NOT_FOUND. A hoisted layout is the
# reproducible fix for this project and is safe for Vercel builds.
node-linker=hoisted
